{
  "name": "testwatch-demo-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Fieldmark Supply — a small, realistic demo shop for trying end-to-end testing tools (TestWatch, Playwright).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
